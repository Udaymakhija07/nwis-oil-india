# Backend Node Server
PORT=5050
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_sih2026_oil_india_nwis
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL 16 + PostGIS + pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_USER=nwis_admin
DB_PASSWORD=nwis_secure_pass_2026
DB_NAME=nwis_db
DATABASE_URL=postgres://nwis_admin:nwis_secure_pass_2026@localhost:5432/nwis_db

# Redis (Caching & Job Queue BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
