# MinIO (Object Storage for WCR / DDR PDFs)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=oil_admin
MINIO_ROOT_PASSWORD=oil_minio_pass_2026
MINIO_BUCKET=nwis-documents

# Python AI Service
AI_SERVICE_URL=http://localhost:8000
